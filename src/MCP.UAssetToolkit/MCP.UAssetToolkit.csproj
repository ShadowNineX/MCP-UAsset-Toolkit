<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MCP UAsset Toolkit</AssemblyName>
    <RootNamespace>MCP_UAsset_Toolkit</RootNamespace>
    <StartupObject>MCP_UAsset_Toolkit.Source.Program</StartupObject>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202609" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- Override CUE4Parse's vulnerable transitive version (GHSA-73j8-2gch-69rq). -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MCP.UAssetToolkit.Tests" />
    <ProjectReference Include="../../UAssetAPI/UAssetAPI/UAssetAPI.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
